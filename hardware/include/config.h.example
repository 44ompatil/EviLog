#pragma once
/**
 * config.h.example
 * EviLog — Configuration Template
 *
 * IMPORTANT: Copy this file to config.h and fill in your real values.
 *            config.h is listed in .gitignore — NEVER commit real credentials.
 *
 * Usage:
 *   cp include/config.h.example include/config.h
 *   # then edit config.h with your actual WiFi and backend details
 */

// ── WiFi Credentials ──────────────────────────────────────────────
#define WIFI_SSID       "your_wifi_network_name"
#define WIFI_PASSWORD   "your_wifi_password"

// ── Backend (FastAPI) Connection ──────────────────────────────────
// IP address of the laptop running: uvicorn app.main:app --reload
// Find your laptop's IP: ipconfig (Windows) or ip a (Linux/macOS)
#define BACKEND_HOST    "192.168.1.100"
#define BACKEND_PORT    8000
#define BACKEND_PATH    "/api/hardware/events"

// ── Device Identity ───────────────────────────────────────────────
// Location label sent with backend events.
// Match the naming scheme used in the backend/frontend.
#define DEVICE_LOCATION "Locker-A"

// ── WiFi Timeout ──────────────────────────────────────────────────
#define WIFI_CONNECT_TIMEOUT_MS  10000   // 10 seconds

// ── HTTP Request Timeout ──────────────────────────────────────────
#define HTTP_TIMEOUT_MS          5000    // 5 seconds

// ── Servo Hold Time ───────────────────────────────────────────────
// How long (ms) the servo stays in UNLOCKED position before re-locking
#define SERVO_UNLOCK_HOLD_MS     3000    // 3 seconds

// ── Debug Logging ─────────────────────────────────────────────────
// Set to 1 to enable verbose Serial output; 0 for production
#define EVILOG_DEBUG             1

